{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "types": [],
    "paths": {
      "@kandev/plugin-sdk": ["../../kandev/apps/packages/plugin-sdk/src/index.ts"]
    }
  },
  "include": ["src", "vitest.config.ts"]
}

{
  "name": "kandev-plugin-nulab-backlog-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --jsx=transform --jsx-factory=h --jsx-fragment=Fragment --outfile=../build/ui/bundle.js",
